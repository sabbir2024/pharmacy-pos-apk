{
  "expo": {
    "name": "Pharmacy POS",
    "slug": "pharmacy-pos",
    "version": "3.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pharmacypos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "buildNumber": "4",
      "infoPlist": {
        "NSCameraUsageDescription": "ঔষধের বারকোড স্ক্যান করার জন্য ক্যামেরা প্রয়োজন।",
        "NSFaceIDUsageDescription": "ডেটা সুরক্ষিত রাখতে Face ID ব্যবহার করুন।"
      },
      "bundleIdentifier": "com.sabbir1999.pharmacypos"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 5,
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "package": "com.sabbir1999.pharmacypos"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "ঔষধের বারকোড স্ক্যান করার জন্য ক্যামেরার অনুমতি দিন।"
        }
      ],
      "expo-sharing",
      "expo-file-system",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "ডেটা সুরক্ষিত রাখতে Face ID ব্যবহার করুন।"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}